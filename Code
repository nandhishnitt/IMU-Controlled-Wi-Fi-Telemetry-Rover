const int IN3_PIN = 22; 
const int IN4_PIN = 23; 

WebServer server(80);

// ==========================================
// THE HTML WEBPAGE (IMU Dashboard)
// ==========================================
const char* htmlPage = R"rawliteral(
<!DOCTYPE html>
<html>
<body style="text-align: center; font-family: sans-serif; margin-top: 50px;">

  <h1>IMU Steering</h1>
  <button onclick="start()" style="font-size: 30px; padding: 20px 40px; background: lightgreen;">START</button>
  <br><br>
  <button onclick="stop()" style="font-size: 30px; padding: 20px 40px; background: pink;">STOP</button>
  <h2 id="msg">L: 0 R: 0</h2>
  
  <script>
    let active = false;
    let last = 0;

    function start() {
      active = true; 
      document.getElementById('msg').innerText = "ACTIVE - TILT PHONE";
    }

    function stop() {
      active = false;
      fetch('/drive?l=0&r=0');
      document.getElementById('msg').innerText = "STOPPED";
    }

    window.addEventListener("deviceorientation", e => {
      if (!active || Date.now() - last < 250) return; 
      last = Date.now();

      // 1. Calculate Throttle using map() with Kickstart
      // Deadzone is 15 degrees. Maps 15->60 degrees to 80->200 PWM.
      let t = 0;
      if (e.beta > 15) { t = map(e.beta, 15, 60, 80, 200); }      
      else if (e.beta < -15) { t = map(e.beta, -15, -60, -80, -200); }

      // 2. Calculate Steering using map()
      // Deadzone is 10 degrees. Maps 10->45 degrees to 0->100 steering offset.
      let s = 0;
      if (e.gamma > 10) { s = map(e.gamma, 10, 45, 0, 100); }
      else if (e.gamma < -10) { s = map(e.gamma, -10, -45, 0, -100); }

      // 3. Mix and Clamp
      let l = Math.round(t + s);
      let r = Math.round(t - s);
      
      l = Math.max(-200, Math.min(200, l));
      r = Math.max(-200, Math.min(200, r));

      document.getElementById('msg').innerText = "L: " + l + " R: " + r;
      fetch(`/drive?l=${l}&r=${r}`);
    });

    
    function map(x, in_min, in_max, out_min, out_max) {
      let val = (x - in_min) * (out_max - out_min) / (in_max - in_min) + out_min;
      
      // Clamp the return value so it doesn't exceed the bounds if you tilt too far
      return Math.max(Math.min(val, Math.max(out_min, out_max)), Math.min(out_min, out_max));
    }
  </script>

</body>
</html>
)rawliteral";

// ==========================================
// SETUP & MAIN LOOP
// ==========================================
void setup() {
  Serial.begin(115200);

  // Set motor pins as outputs
  pinMode(ENA_PIN, OUTPUT); pinMode(IN1_PIN, OUTPUT); pinMode(IN2_PIN, OUTPUT);
  pinMode(ENB_PIN, OUTPUT); pinMode(IN3_PIN, OUTPUT); pinMode(IN4_PIN, OUTPUT);
  
  // Ensure motors are off at boot
  stopMotors();

  // Connect to Home Wi-Fi
  Serial.print("Connecting to ");
  Serial.println(ssid);
  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("");
  Serial.println("WiFi connected successfully!");
  Serial.print("Open your browser and go to this IP: ");
  Serial.println(WiFi.localIP()); 

  // Define URLs
  server.on("/", []() { server.send(200, "text/html", htmlPage); });
  
  // New dynamic endpoint that reads the L and R values from the URL
  server.on("/drive", []() {
    if (server.hasArg("l") && server.hasArg("r")) {
      int l = server.arg("l").toInt();
      int r = server.arg("r").toInt();
      driveMotors(l, r);
    }
    server.send(200);
  });

  server.begin();
}

void loop() {
  server.handleClient();
}

// ==========================================
// MOTOR CONTROL HELPER FUNCTIONS
// ==========================================

void driveMotors(int leftSpeed, int rightSpeed) {
  // Constrain speeds to safe limits for the motors (-200 to 200 max)
  leftSpeed = constrain(leftSpeed, -200, 200);
  rightSpeed = constrain(rightSpeed, -200, 200);

  // --- Left Motor Logic ---
  if (leftSpeed >= 0) {
    // Drive Forward
    digitalWrite(IN1_PIN, HIGH); 
    digitalWrite(IN2_PIN, LOW); 
    analogWrite(ENA_PIN, leftSpeed);
  } else {
    // Drive Backward
    digitalWrite(IN1_PIN, LOW); 
    digitalWrite(IN2_PIN, HIGH); 
    // abs() turns the negative number into a positive PWM value
    analogWrite(ENA_PIN, abs(leftSpeed)); 
  }

  // --- Right Motor Logic ---
  if (rightSpeed >= 0) {
    // Drive Forward
    digitalWrite(IN3_PIN, HIGH); 
    digitalWrite(IN4_PIN, LOW); 
    analogWrite(ENB_PIN, rightSpeed);
  } else {
    // Drive Backward
    digitalWrite(IN3_PIN, LOW); 
    digitalWrite(IN4_PIN, HIGH); 
    analogWrite(ENB_PIN, abs(rightSpeed));
  }
}

void stopMotors() {
  digitalWrite(IN1_PIN, LOW); digitalWrite(IN2_PIN, LOW);
  digitalWrite(IN3_PIN, LOW); digitalWrite(IN4_PIN, LOW);
  analogWrite(ENA_PIN, 0); analogWrite(ENB_PIN, 0);
}
